AWS_PRIVATE_BUCKET_NAME=

# can set to dummy if you are not using stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


FIREBASE_CREDENTIAL=


# add more as needed

# Auto-sync configuration
# Enable/disable automatic reconciliation on server startup
AUTO_SYNC_ON_STARTUP=true

# How many hours of checkout history to sync (default: 48)
# Increase this if you expect longer downtimes
AUTO_SYNC_HOURS_BACK=48

MONGO_DB_NAME=

EXERCISE_THUMBNAIL_BASE_PATH=thumbnail/

EXERCISE_AUDIO_BASE_PATH=audio/

REACT_BASE_URL=http://localhost:8080
API_ENDPOINT=http://localhost:8080/api