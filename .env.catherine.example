NODE_ENV=development

VITE_REACT_BASE_URL=http://localhost:8080
VITE_APIDOMAIN=http://localhost:8080
VITE_API_ENDPOINT=http://localhost:8080/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

VITE_EMAIL_DOMAIN=

# please ask the team for this specific secret
VITE_PASSWORD_AES_SECRET=
VITE_ENCRYPTION_SECRET_KEY=

# can set to dummy if you are not using stripe
VITE_STRIPE_PRICING_TABLE_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

